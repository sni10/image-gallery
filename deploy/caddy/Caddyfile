# Production entry point: HTTPS (Let's Encrypt, automatic), static files, reverse proxy to gunicorn.
# The app trusts X-Forwarded-Proto and the last X-Forwarded-For entry (settings.NUM_PROXIES = 1): Caddy sends
# exactly one XFF value, the client IP. Behind the Cloudflare proxy that IP comes from CF-Connecting-IP, which is
# believed only when the connection itself comes from Cloudflare's networks (anyone else can't spoof it).
{
	email {$ACME_EMAIL}
	servers {
		# ponytail: static copy of https://www.cloudflare.com/ips-v4 and /ips-v6 (09.10.2026); they change rarely,
		# re-check when the proxy is touched. Upgrade path: a Caddy build with the caddy-cloudflare-ip module.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# HSTS: browsers that saw us use HTTPS only. Raised in steps (see DEPLOY.md): 300 s -> 1 week -> 1 year.
# No includeSubDomains (mail.artai.win belongs to Brevo) and no preload until it has run at a year without issues.
(hsts) {
	header Strict-Transport-Security "max-age=300"
}

# Thumbs are public: names are SHA-256 of the content, a URL never changes -> cache forever.
# Originals only with a valid signed link from the API (?exp&sig): forward_auth asks the app (HMAC, no DB).
# private: browsers may cache them, Cloudflare and other shared caches must not (they would skip the check).
(media) {
	handle /media/thumb/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle /media/original/* {
		forward_auth app:8000 {
			uri /internal/media-auth
			header_up X-Forwarded-For {client_ip}  # the per-IP originals limit needs the client, not Cloudflare
		}
		root * /srv
		header Cache-Control "private, max-age=3600"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle /media/* {
		respond 404
	}
}

# Admin CSS/JS after collectstatic: names are not hashed.
(static) {
	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=604800"
		encode zstd gzip
		file_server
	}
}

(app) {
	handle {
		encode zstd gzip
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# Frontend: SSR Node server (front service, image from ../image-gallery-front). Vite's /assets/* have hashed names.
artai.win {
	import hsts
	encode zstd gzip
	@assets path /assets/*
	header @assets >Cache-Control "public, max-age=31536000, immutable"
	# sitemap is built by the API from the DB; Host must be one the app allows, urls inside point to artai.win
	handle /sitemap.xml {
		reverse_proxy app:8000 {
			header_up Host api.artai.win
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		reverse_proxy front:5173
	}
}

www.artai.win {
	import hsts
	redir https://artai.win{uri} permanent
}

# Public API and images. The admin lives on secure.artai.win only.
# Robots: images are indexable (Google Images, og:image previews), JSON is not.
api.artai.win {
	import hsts
	@not_media not path /media/*
	header @not_media X-Robots-Tag "noindex"
	handle /robots.txt {
		respond "User-agent: *
Allow: /media/
Disallow: /
" 200
	}
	request_body {
		max_size 500MB
	}
	import media
	import static
	handle /admin* {
		respond 404
	}
	handle /internal/* {
		respond 404
	}
	import app
}

# Monitoring (Beszel hub, own login). Same certificate as secure.artai.win; ufw must allow 8443/tcp.
secure.artai.win:8443 {
	import hsts
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy beszel:8090
}

# Admin (bulk uploads go here). Closed to robots: robots.txt disallows everything, every response carries
# X-Robots-Tag noindex, and crawlers / scripted clients get 403 before reaching the app (only browsers need the admin).
# Restrict to own IPs later if needed: `@outside not remote_ip ...` + respond 403.
secure.artai.win {
	import hsts
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
	request_body {
		max_size 500MB
	}
	@robots header_regexp User-Agent (?i)(bot|crawl|spider|slurp|archiver|scrap|fetch|preview|curl|wget|python|httpclient|okhttp|go-http|java/|libwww|headless|^$)
	@no_agent not header User-Agent *
	route {
		# route keeps this exact order: the bans run before any file or app handler
		respond /robots.txt "User-agent: *
Disallow: /
" 200
		respond @robots 403
		respond @no_agent 403
		respond /internal/* 404
		import media
		import static
		import app
	}
}
