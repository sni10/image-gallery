# Production .env for /srv/artai on the server (next to compose.prod.yaml). Never commit the real file.
# Values marked GENERATE are created on the server, e.g.:  openssl rand -base64 48 | tr -d '\n/+='

# Images to run (commit SHAs): set by deploy/deploy.sh of the backend / frontend repo
IMAGE_TAG=
FRONT_TAG=

# Django
DJANGO_SECRET_KEY='GENERATE'
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.artai.win,secure.artai.win

# PostgreSQL (the db service in compose.prod.yaml)
DB_NAME=image_gallery
DB_USER=gallery
DB_PASSWORD='GENERATE'
DB_HOST=db
DB_PORT=5432

# The SPA calling the API
CORS_ALLOWED_ORIGINS=https://artai.win
FRONTEND_URL=https://artai.win

# Files inside the app container (volumes in compose.prod.yaml). MEDIA_URL must stay relative:
# image links are built from the request host (https://api.artai.win/media/...).
MEDIA_ROOT=media
MEDIA_URL=media/
STATIC_ROOT=staticfiles

# Let's Encrypt account email (expiry notices)
ACME_EMAIL=d.strelets.a@gmail.com

# Outgoing email: console = emails go to `docker compose logs app` until Brevo is set up
EMAIL_BACKEND=console
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
EMAIL_SENDER='ArtAI <noreply@artai.win>'
