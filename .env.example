# Copy to .env and fill in. Real environment variables override values from .env.

# Django
DJANGO_SECRET_KEY='change-me-to-a-random-50+-char-string'
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=image_gallery
DB_USER=dev
DB_PASSWORD=dev
DB_HOST=db
DB_PORT=5432

# Frontend origins allowed to call the API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Uploaded files (relative paths are resolved against the project root)
MEDIA_ROOT=media
MEDIA_URL=media/
# Signs links to originals; empty in debug = derived from DJANGO_SECRET_KEY
MEDIA_SIGNING_KEY=

# collectstatic target served by nginx (relative paths are resolved against the project root)
STATIC_ROOT=staticfiles

# docker compose: host port of nginx (API, admin, media)
NGINX_PORT=8080

# SPA address: links in emails (email confirmation, email change) point here
FRONTEND_URL=http://localhost:5173

# Outgoing email. console = print emails to the app log; smtp = real delivery.
# Local compose with Mailpit (UI at http://localhost:8025): EMAIL_BACKEND=smtp EMAIL_HOST=mailpit EMAIL_PORT=1025 EMAIL_USE_TLS=false
EMAIL_BACKEND=console
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
EMAIL_SENDER='Image Gallery <noreply@example.com>'

# Photo upload API for automation (POST /ingest/photos, header X-Api-Key), e.g. ComfyUI.
# Empty = uploads off (403). Generate: openssl rand -hex 32
INGEST_API_KEY=

# POST /complaints (form on the site): complaints are emailed here, Reply-To = the complainant.
# Never shown on the site. Empty = complaints are only stored (admin -> Complaints).
COMPLAINTS_EMAIL=
# Cloudflare Turnstile secret key: captcha on the complaint form (the site key goes to the frontend).
# Empty = Cloudflare's test key that always passes: fine locally, never in production.
TURNSTILE_SECRET=
