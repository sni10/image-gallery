# Copy to .env and fill in. Real environment variables override values from .env.

# Django
DJANGO_SECRET_KEY='change-me-to-a-random-50+-char-string'
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=image_gallery
DB_USER=dev
DB_PASSWORD=dev
DB_HOST=localhost
DB_PORT=5432

# manage.py runserver default address
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend origins allowed to call the API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Uploaded files (relative paths are resolved against the project root)
MEDIA_ROOT=media
MEDIA_URL=media/

# collectstatic target served by nginx (relative paths are resolved against the project root)
STATIC_ROOT=staticfiles

# docker compose: host port of nginx (API, admin, media)
NGINX_PORT=8080
